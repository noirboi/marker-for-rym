{
  "manifest_version": 3,
  "name": "Marker for RYM",
  "version": "1.2.0",
  "description": "Sync and highlight your RateYourMusic ratings on charts and lists. Optional badges. Chrome and Firefox.",
  "homepage_url": "https://rym.fm/discussion/rate-your-music/_chrome-extension-marker-for-rym-highlight-your-rated-items-on-charts-and-lists/",
  "browser_specific_settings": {
    "gecko": {
      "id": "marker-for-rym@noirboi",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://rateyourmusic.com/*", "*://*.rateyourmusic.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Marker for RYM",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://rateyourmusic.com/*", "*://*.rateyourmusic.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
